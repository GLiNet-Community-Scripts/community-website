---
/*
 * The advisory at the top of the home page: the full panel while it is
 * active (collapsible, remembered per revision), a one-line "resolved" card
 * for a while after it is fixed (dismissible). Details live on the
 * advisory's own page; this panel only says what happened and what to do.
 */
import AdvisoryEyebrow from './AdvisoryEyebrow.astro';
import AdvisoryRefs from './AdvisoryRefs.astro';
import type { Advisory } from '../lib/advisories';
import { when } from '../lib/format';
import { UI } from '../lib/ui';

interface Props {
  advisory: Advisory;
  /** Other active advisories besides this one. */
  more: number;
}

const { advisory: a, more } = Astro.props;
const key = `${a.id}@${a.updated}`;
const statement = a.sources.find((s) => s.type.startsWith('gl-inet') && s.url);
// Community notes to read before acting on the steps; other notes get a line after them.
const before = a.community?.notes.filter((n) => n.before) ?? [];
---

<div class="container adv-wrap">
  {a.level === 'resolved' ? (
    <article class="adv is-compact" id="advisory" data-level="resolved" data-dismissible={`advisory:${key}`} aria-labelledby="adv-title">
      <div class="adv-head">
        <span class="tile sm adv-tile" aria-hidden="true" set:html={UI.shieldOk} />
        <div class="adv-titles">
          <p class="adv-eyebrow"><span>Resolved</span><span>{when(a.updated)}</span></p>
          <h2 id="adv-title">{a.title}</h2>
          <p class="adv-compact-line">{a.banner} <a href={a.url}>Read the advisory</a></p>
        </div>
        <button class="close" type="button" data-dismiss={`advisory:${key}`} aria-label="Dismiss" set:html={UI.close} />
      </div>
    </article>
  ) : (
    <article class="adv" id="advisory" data-level={a.level} data-collapsible={key} aria-labelledby="adv-title">
      <div class="adv-head">
        <span class="tile lg adv-tile" aria-hidden="true" set:html={UI.shield} />
        <div class="adv-titles">
          <AdvisoryEyebrow advisory={a} />
          <h2 id="adv-title">{a.title}</h2>
        </div>
        <button class="adv-toggle" type="button" data-toggle aria-expanded="true" aria-controls="advisory" aria-label="Hide details">
          <Fragment set:html={UI.chevronUp} /><span class="t">Hide details</span>
        </button>
      </div>
      <div class="adv-body">
        <p class="adv-lead">{a.summary}</p>
        <div class="adv-do">
          <h3>What to do now</h3>
          {before.map((n) => (
            <p class="do-before"><b>Before you start:</b> {n.before} <a href={`${a.url}#community`}>Read our note first</a></p>
          ))}
          <div class:list={['adv-do-cols', { two: a.actions.length > 1 }]}>
            {a.actions.map((g) => (
              <div>
                {g.audience && <h4>{g.audience}</h4>}
                <ol class="adv-steps">{g.steps.map((s) => <li>{s.title}</li>)}</ol>
              </div>
            ))}
          </div>
        </div>
        {a.community && before.length === 0 && (
          <p class="adv-community">
            <b>Community note:</b> {a.community.notes[0].title}.{' '}
            <a href={`${a.url}#community`}>Read our view</a>
          </p>
        )}
        <div class="adv-foot">
          <a class="btn-install lg" href={a.url}>Read the full advisory</a>
          {statement && <a class="btn-soft lg" href={statement.url}>GL.iNet’s notice ↗</a>}
          {more > 0 && <a class="more" href="/security/">{more} more active →</a>}
        </div>
        <AdvisoryRefs advisory={a} />
        <p class="adv-fine">Written by the community, not GL.iNet. Get firmware only from GL.iNet; we never host firmware or ask for passwords.</p>
      </div>
    </article>
  )}
  <script is:inline>
    // Restore "hide details" / "dismiss" before the panel paints.
    (function () {
      var el = document.getElementById('advisory');
      try {
        if (el.dataset.collapsible && localStorage.getItem('collapsed:' + el.dataset.collapsible) === '1') {
          el.classList.add('is-compact');
          var b = el.querySelector('[data-toggle]');
          b.setAttribute('aria-expanded', 'false');
          b.setAttribute('aria-label', 'Show details');
          b.querySelector('.t').textContent = 'Show details';
        }
        if (el.dataset.dismissible && localStorage.getItem('dismissed:' + el.dataset.dismissible) === '1') {
          el.parentElement.hidden = true;
        }
      } catch (e) {}
    })();
  </script>
</div>
