---
import Tile from './Tile.astro';
import { TYPE_LABEL, type App } from '../lib/content';
import { fmt, longDate } from '../lib/format';
import { UI } from '../lib/ui';

interface Props {
  app: App;
  org: string;
}

const { app, org } = Astro.props;
const repoUrl = `https://github.com/${org}/${app.repo}`;
const isMirror = app.upstream.toLowerCase() !== `${org}/${app.repo}`.toLowerCase();
---

<div class="sheet" tabindex="-1">
  <div class="sheet-head">
    <Tile icon={app.icon} gradient={app.gradient} size="xl" />
    <div class="heading">
      <h2 class="sheet-title">{app.name}</h2>
      <p class="tagline">{app.tagline}</p>
      <p class="by">by {app.author} · {TYPE_LABEL[app.type]}</p>
    </div>
    <button class="close" type="button" data-close aria-label="Close" set:html={UI.close} />
  </div>
  <div class="kv">
    <div><span>Stars</span><b>{fmt(app.stars)}</b></div>
    <div><span>Version</span><b>{app.version ?? 'No release'}</b></div>
    <div><span>Updated</span><b>{app.updated ? longDate(app.updated) : 'Unknown'}</b></div>
    <div><span>Licence</span><b>{app.license ?? 'Not stated'}</b></div>
  </div>
  <p class="lead">{app.description}</p>
  {app.features.length > 0 && (
    <div>
      <h4>Features</h4>
      <ul class="features">
        {app.features.map((f) => <li><Fragment set:html={UI.tick} /><span>{f}</span></li>)}
      </ul>
    </div>
  )}
  {app.devices.length > 0 ? (
    <div>
      <h4>Supported models</h4>
      <div class="dev">{app.devices.map((d) => <span>{d}</span>)}</div>
      {app.firmware && <p class="hint">Firmware: {app.firmware}</p>}
    </div>
  ) : app.firmware && (
    <div><h4>Requirements</h4><p>Firmware: {app.firmware}</p></div>
  )}
  {app.notes && <div class="note"><Fragment set:html={UI.warn} /><p>{app.notes}</p></div>}
  <div class="sheet-links">
    <a class="btn-install lg" href={`https://github.com/${app.upstream}#readme`} data-install={app.id}>Install</a>
    <a href={repoUrl}>Open on GitHub ↗</a>
    {isMirror && <a href={`https://github.com/${app.upstream}`}>Original repository ↗</a>}
    {app.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}
  </div>
  <p class="credit">
    Made by <a href={`https://github.com/${app.author}`}>{app.author}</a>. This organization keeps a synced
    copy; the author keeps ownership and credit.{app.tech.length > 0 && ` Built with ${app.tech.join(', ')}.`}
  </p>
</div>
