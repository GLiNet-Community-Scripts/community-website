---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import AdvisoryEyebrow from '../../components/AdvisoryEyebrow.astro';
import Terminal from '../../components/Terminal.astro';
import Tile from '../../components/Tile.astro';
import { SEVERITY, SOURCE_TYPE } from '../../lib/advisories';
import { loadContent } from '../../lib/content';
import { dayTime, longDate, when } from '../../lib/format';
import { UI } from '../../lib/ui';

export function getStaticPaths() {
  return loadContent().security.advisories.map((a) => ({ params: { slug: a.slug } }));
}

const { site, generatedAt, security, tools, official } = loadContent();
const { advisories } = security;
const i = advisories.findIndex((x) => x.slug === Astro.params.slug);
const a = advisories[i];
const newer = advisories[i - 1];
const older = advisories[i + 1];
const apps = a.apps.map((id) => [...tools, ...official].find((x) => x.id === id)!);
const paragraphs = (a.details ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const url = new URL(a.url, site.url).href;
const level = a.tone;
const cve = a.cve === 'requested' ? 'Requested' : a.cve.length === 0 ? 'None assigned' : null;
// Community notes to read before acting on "Do this now", gathered in one box. Each line
// links to its note; a note without an id links to the section.
const before = a.community?.notes.filter((n) => n.before) ?? [];
const fix = a.community_fix;
// The "reported" tables: one per kind of device, because routers and KVMs count their
// firmware differently. A column is a release series (4.8), a cell holds the versions of
// that series with reports (4.8.3, 4.8.4). One column per version made the table scroll.
const verKey = (v: string) => v.split(/[^0-9]+/).filter(Boolean).map((n) => n.padStart(4, '0')).join('.');
const byVer = (x: string, y: string) => verKey(x).localeCompare(verKey(y));
const series = (v: string) => v.split(/[^0-9]+/).filter(Boolean).slice(0, 2).join('.') || v;
const repModels = a.affected.reported?.models ?? [];
const repGroups = [...new Set(repModels.map((m) => m.kind ?? ''))].map((kind) => {
  const models = repModels.filter((m) => (m.kind ?? '') === kind);
  return { kind, models, cols: [...new Set(models.flatMap((m) => m.firmware.map(series)))].sort(byVer) };
});
const plural = (kind: string) => ({ Router: 'Routers', KVM: 'KVM devices' }[kind] ?? (kind || 'Devices'));
const confirmed = { 'gl-inet-public': 'By GL.iNet, publicly', 'gl-inet-staff': 'By GL.iNet staff', unconfirmed: 'Not yet' }[a.confirmed];
---

<Layout title={`${a.id}: ${a.title} · gl-i.net (unofficial)`} description={a.summary} url={url}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="gl-i.net security advisories" href="/security/feed.xml" />
  <SiteHeader site={site} security={security} page="advisory" current={a} />

  <main id="top">
    <article class="container sa-article" data-level={level}>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Community Apps</a><span class="sep">/</span><a href="/security/">Security advisories</a><span class="sep">/</span><span aria-current="page" class="mono">{a.id}</span>
      </nav>

      <header class="sa-header">
        <AdvisoryEyebrow advisory={a} />
        <h1>{a.title}</h1>
        <p class="sub">{a.summary}</p>
      </header>

      <dl class="sa-facts">
        <div><dt>Community ID</dt><dd><span class="mono">{a.id}</span><button class="copy-id" type="button" data-copy={a.id}><span>Copy</span></button></dd></div>
        <div><dt>CVE</dt><dd>{cve ?? a.cve.map((c) => <a class="mono" href={`https://www.cve.org/CVERecord?id=${c}`}>{c}</a>)}</dd></div>
        <div><dt>Severity</dt><dd class="sev">{SEVERITY[a.severity].label}</dd></div>
        <div><dt>Exploited</dt><dd>{a.exploited ? 'Yes' : 'Not known'}</dd></div>
        <div><dt>Status</dt><dd>{a.statusLabel}</dd></div>
        <div><dt>Confirmed</dt><dd>{confirmed}</dd></div>
        <div><dt>Fixed in</dt><dd>{a.fixedIn ?? 'Not released yet'}</dd></div>
        <div><dt>Updated</dt><dd>{when(a.updated)}</dd></div>
      </dl>
      <p class="adv-refs sa-facts-note">
        <span>Published {longDate(a.published)}</span>{' '}
        <span>Severity is our rating{a.vendor_severity ? `, GL.iNet’s is “${a.vendor_severity}”` : ''}</span>
        {a.cve.length === 0 && <Fragment>{' '}<span>Not every issue gets a CVE</span></Fragment>}
        {a.rollout && <Fragment>{' '}<span>{a.rollout.released} of {a.rollout.total} models have the fix</span></Fragment>}
      </p>

      <section id="do" class="do-box" aria-labelledby="h-do">
        <h2 id="h-do">{a.active ? 'Do this now' : 'What to do'}</h2>
        {fix?.command ? (
          <div id="community-fix" class="do-first">
            {fix.image && <img src={fix.image} width="240" height="200" alt="" />}
            <div>
              <p class="do-first-eyebrow">Start here · Community script, not a GL.iNet tool</p>
              <h3>{fix.title}</h3>
              {fix.before && <p>{fix.before}</p>}
              {fix.does.length > 0 && <ul>{fix.does.map((d) => <li>{d}</li>)}</ul>}
              <Terminal command={fix.command} label="root@device" variants={fix.command_variants} />
              {fix.version_url && (
                <p class="do-ver" data-version-src={fix.version_url}>
                  <b class="do-ver-again">Ran it before? Run it again.</b>
                  {fix.rerun && <span>{fix.rerun}</span>}
                  <span class="do-ver-now">
                    Current version: <b data-script-version>shown in the first line of the script’s output</b>
                    <span data-script-released hidden></span>
                  </span>
                </p>
              )}
              {fix.author && <p class="do-first-author">{fix.author}</p>}
              <p class="do-first-link">
                <a href={fix.link.url}>{fix.link.label}&nbsp;{fix.link.url.startsWith('/') ? '→' : '↗'}</a>
              </p>
            </div>
            <p class="do-first-foot">{fix.caveat}</p>
          </div>
        ) : fix?.before && (
          <p class="do-before">
            <b>Before you reset:</b> {fix.before}{' '}
            <a href={fix.link.url}>{fix.link.label}&nbsp;{fix.link.url.startsWith('/') ? '→' : '↗'}</a>
          </p>
        )}
        {before.length > 0 && (
          <div class="do-before">
            <b>{fix?.command ? 'Before you go on' : 'Before you start'}</b>
            <ul>
              {before.map((n) => <li>{n.before} <a href={`#${n.id ?? 'community'}`}>Why&nbsp;↓</a></li>)}
            </ul>
          </div>
        )}
        {fix?.command && <h3 class="do-alt">Or check by hand, as GL.iNet’s notice says</h3>}
        <div class:list={['do-cols', { two: a.actions.length > 1 }]}>
          {a.actions.map((g) => (
            <div>
              {g.audience && <h3>{g.audience}</h3>}
              <ol class="adv-steps">
                {g.steps.map((s) => (
                  <li>
                    <b>{s.title}</b>
                    {(s.text || s.link) && (
                      <span>{s.text}{s.link && <Fragment>{s.text && ' '}<a href={s.link.url}>{s.link.label}&nbsp;↗</a></Fragment>}</span>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      {a.community_fix && !a.community_fix.command && (
        <section id="community-fix" class="fix-card" aria-labelledby="h-fix">
          {a.community_fix.image && <img src={a.community_fix.image} width="240" height="200" alt="" />}
          <div>
            <p class="fix-card-eyebrow">Community fix · Not from GL.iNet</p>
            <h2 id="h-fix">{a.community_fix.title}</h2>
            {a.community_fix.text.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}
            <a class="fix-card-btn" href={a.community_fix.link.url}>
              {a.community_fix.link.label}&nbsp;{a.community_fix.link.url.startsWith('/') ? '→' : '↗'}
            </a>
            <p class="fix-card-caveat">{a.community_fix.caveat}</p>
          </div>
        </section>
      )}

      {a.community && (
        <section id="community" class="community-box" aria-labelledby="h-community">
          <h2 id="h-community">The community team’s view</h2>
          {a.community.notes.map((n) => (
            <Fragment>
              <h3 id={n.id}>{n.title}</h3>
              {n.text.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}
              {n.link && <p><a href={n.link.url}>{n.link.label}&nbsp;{n.link.url.startsWith('/') ? '→' : '↗'}</a></p>}
            </Fragment>
          ))}
          <p class="adv-fine">
            Our assessment as the maintainers of gl-i.net, {longDate(a.community.date)}. Not GL.iNet’s advice, and not
            legal or insurance advice.
          </p>
        </section>
      )}

      <section id="models" aria-labelledby="h-models">
        <h2 id="h-models">Who is affected</h2>
        <p>{a.affected.summary}</p>
        {(a.affected.firmware || a.affected.not_affected) && (
          <p class="adv-refs">
            {a.affected.firmware && <span>Firmware: {a.affected.firmware}</span>}
            {a.affected.not_affected && <Fragment>{' '}<span>Not affected: {a.affected.not_affected}</span></Fragment>}
          </p>
        )}
        {a.affected.reported && (
          <Fragment>
            <h3 class="sa-h3">Where traces have been reported</h3>
            <p class="adv-refs">
              <span>As of {when(a.affected.reported.as_of)}</span>{' '}
              <span>{a.affected.reported.models.length} models</span>{' '}
              <span>Source: <a href={a.affected.reported.source.url}>{a.affected.reported.source.label}&nbsp;↗</a></span>
            </p>
            {repGroups.map((g) => (
              <div class="sa-table-wrap rep-wrap">
                <table class="rep-table">
                  <caption>{plural(g.kind)} <span>{g.models.length} {g.models.length === 1 ? 'model' : 'models'}</span></caption>
                  <thead>
                    <tr><th>Model</th>{g.cols.map((c) => <th class="v">{c}</th>)}</tr>
                  </thead>
                  <tbody>
                    {g.models.map((m) => (
                      <tr>
                        <th scope="row"><b>{m.name}</b>{m.sku && m.sku !== m.name && <small>{m.sku}</small>}</th>
                        {m.firmware.length === 0 ? (
                          <td class="unknown" colspan={g.cols.length}>Traces reported, firmware not known</td>
                        ) : g.cols.map((c) => {
                          const vs = m.firmware.filter((v) => series(v) === c).sort(byVer);
                          return <td class={vs.length ? 'c' : 'c none'}>{vs.map((v) => <span class="ver">{v}</span>)}</td>;
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
            <p class="rep-legend"><span class="ver">4.8.3</span> Traces reported on this firmware <span class="sep">·</span> Empty: no report so far. That does not mean “not affected”.</p>
            {a.affected.reported.note && a.affected.reported.note.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}
          </Fragment>
        )}
        {a.models.length > 0 && (
          <div class="sa-table-wrap">
            <table class="sa-table">
              <thead><tr><th>Model</th><th>Affected</th><th>Fix</th><th>Status</th></tr></thead>
              <tbody>
                {a.models.map((m) => (
                  <tr class:list={{ eol: m.eol }}>
                    <td><b>{m.name}</b>{m.sku && <small>{m.sku}</small>}</td>
                    <td>{m.affected}</td>
                    <td class="fix">{m.eol ? '–' : (m.fixed ?? 'Not yet')}</td>
                    <td>
                      {m.eol ? (
                        <Fragment><span class="st-cell no"><Fragment set:html={UI.noCircle} />No fix</span><small>{m.note ?? 'end of life'}</small></Fragment>
                      ) : m.released ? (
                        <Fragment><span class="st-cell ok"><Fragment set:html={UI.okCircle} />Available</span><small>{m.note ?? `since ${dayTime(m.released)}`}</small></Fragment>
                      ) : (
                        <Fragment><span class="st-cell wait"><Fragment set:html={UI.pending} />Pending</span><small>{m.note ?? m.expected ?? 'no date yet'}</small></Fragment>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {a.check.length > 0 && (
        <section id="check" aria-labelledby="h-check">
          <h2 id="h-check">Check your device</h2>
          <div class="check">
            {a.check.map((c) => (
              <div class="panel">
                <h3>{c.title}</h3>
                {c.menu && <p class="path">{c.menu.map((m, j) => <Fragment>{j > 0 && <span>→</span>}{m}</Fragment>)}</p>}
                {c.text && <p>{c.text}</p>}
                {c.command && <Terminal command={c.command} label="root@router" />}
              </div>
            ))}
          </div>
        </section>
      )}

      {(paragraphs.length > 0 || a.unknowns.length > 0) && (
        <section id="details" aria-labelledby="h-details">
          <h2 id="h-details">What we know</h2>
          {paragraphs.map((p) => <p>{p}</p>)}
          {a.unknowns.length > 0 && (
            <Fragment>
              <h3 class="sa-h3">What we don’t know yet</h3>
              <ul class="unknowns">{a.unknowns.map((u) => <li>{u}</li>)}</ul>
            </Fragment>
          )}
        </section>
      )}

      <section id="timeline" aria-labelledby="h-timeline">
        <h2 id="h-timeline">Timeline</h2>
        <ol class="sa-time">
          {a.timeline.map((t) => (
            <li><time datetime={t.at}>{when(t.at)}</time><span>{t.text}{t.tag && <span class="tl-tag">{t.tag}</span>}</span></li>
          ))}
        </ol>
      </section>

      <section id="sources" aria-labelledby="h-sources">
        <h2 id="h-sources">Sources</h2>
        <ul class="sources">
          {a.sources.map((s) => {
            const t = SOURCE_TYPE[s.type];
            return (
              <li>
                {s.url ? <a href={s.url}>{s.label}&nbsp;↗</a> : <b>{s.label ?? 'Confirmation to the maintainers of this site'}</b>}
                <p class="adv-refs"><span>{t.who}, {t.what.toLowerCase()}</span>{' '}<span>{longDate(s.date)}</span></p>
                {s.note && <p>{s.note}</p>}
              </li>
            );
          })}
        </ul>
        {a.contacts.length > 0 && (
          <p class="adv-refs sa-contacts">
            {a.contacts.map((c, j) => <Fragment>{j > 0 && ' '}<span>{c.label} <a href={`mailto:${c.email}`}>{c.email}</a></span></Fragment>)}
          </p>
        )}
      </section>

      {(apps.length > 0 || a.apps_note) && (
        <section id="apps" aria-labelledby="h-apps">
          <h2 id="h-apps">Community apps</h2>
          {a.apps_note && <p>{a.apps_note}</p>}
          {apps.length > 0 && (
            <ul class="rows">
              {apps.map((app) => (
                <li class="row">
                  <Tile icon={app.icon} gradient={app.gradient} size="sm" />
                  <span class="text"><a class="name" href={`/#${app.id}`}>{app.name}</a><span class="tl">{app.tagline}</span></span>
                  <span class="right"><a class="btn-install soft" href={`/#install-${app.id}`}>Install</a></span>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}

      <p class="adv-fine sa-fine">
        Written by the community, not GL.iNet. Get firmware only from GL.iNet; we never host firmware or ask for passwords.{' '}
        <a href="/security/feed.xml">Follow updates via RSS</a>.
      </p>

      <nav class="sa-pager" aria-label="More advisories">
        <a href="/security/">← All security advisories</a>
        {older ? (
          <a class="next" href={older.url}><small>Previous advisory</small>{older.id} · {older.title}</a>
        ) : newer && (
          <a class="next" href={newer.url}><small>Newer advisory</small>{newer.id} · {newer.title}</a>
        )}
      </nav>
    </article>
  </main>

  <Footer site={site} generatedAt={generatedAt} />

  <script>
    import '../../scripts/alerts.ts';
    import '../../scripts/security.ts';
    import '../../scripts/script-version.ts';
  </script>
</Layout>
